# ============================================================================
# EBSMCP — single configuration file
# ============================================================================
# Copy this to `.env` (same directory as docker-compose.yml), fill in what you
# need, then `docker compose up -d --build`.
#
#   cp .env.example .env
#
# This is the ONE file docker compose reads. The per-service files
# (mcp-server/.env, management-api/.env, admin-gui/.env) are only for running
# those services directly on the host without Docker — compose ignores them.
#
# Every line is optional: omit one and its documented default applies. Values
# are read literally — do NOT wrap them in quotes unless a quote is genuinely
# part of the value. JSON values (lists/objects) must be valid JSON on a
# single line.
# ============================================================================

# --- Database -------------------------------------------------------------
# One superuser owns both databases in this stack. `postgres` is a dev default
# — set a real password for any real deployment. It propagates automatically
# into every service's connection string; you never edit those by hand.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Admin console sign-in ------------------------------------------------
# Unset  -> admin-gui shows the free-text "Acting as" stub (any subject
#           accepted). Set it -> real username/password sign-in. Generate with
# `openssl rand -hex 32`. Rotating it logs every admin out.
# MUST agree with VITE_LOCAL_ADMIN_AUTH_ENABLED below.
# After setting it, create the first admin (no account exists by default):
#   docker compose exec -e IDENTITY_DB_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ebsmcp_identity \
#     management-api python scripts/create_admin.py --username admin@corp.com
ADMIN_SESSION_SECRET=

# "true" (default) = login form; requires ADMIN_SESSION_SECRET + an admin row.
# "false" = the "Acting as" stub. Baked in at build time — changing it needs
# `docker compose build --no-cache admin-gui`.
VITE_LOCAL_ADMIN_AUTH_ENABLED=true

# Browser-reachable URL of management-api. Default works when you browse from
# the Docker host itself. From another machine, set it to the host's LAN
# address, e.g. http://10.0.0.42:8010. Build-time — rebuild admin-gui to change.
VITE_API_BASE_URL=http://localhost:8010

# --- Which environment this deployment serves -----------------------------
# dev | test | uat | prod. Identity mappings are matched against this value.
EBSMCP_ENVIRONMENT=dev

# --- EBS database connection (mcp-server + onboarding lookups) ------------
# Leave all unset to run against the in-memory mock connector.
# ONE instance — the simple form:
EBS_DB_DSN=
EBS_DB_USER=
EBS_DB_PASSWORD=
# THICK MODE. Thin mode (default) cannot log in to an EBS account the server
# authenticates with the old 10g password verifier — which is every account
# when the database has SEC_CASE_SENSITIVE_LOGON=FALSE, failing with DPY-3015.
# Set true to connect to such an instance; the Instant Client is already in
# the mcp-server image. Leave false for the mock or a modern-verifier DB.
EBSMCP_ORACLE_THICK_MODE=false

# # SEVERAL instances — single-line JSON, overrides the three vars above.
# See ebs-instances.sample.env for the annotated shape.
# EBSMCP_EBS_INSTANCES={"PROD":{"dsn":"host:1521/EBSPROD","user":"ebsmcp_ro","password":"..."}}

# --- MCP authentication (Entra ID) ----------------------------------------
# All three unset = ANONYMOUS mode: every caller collapses to the subject
# below, and your ebs_dba identity mapping must use that exact subject.
# Fine for a pilot; set real Entra for production. Setting all three switches
# the MCP server to verifying real bearer tokens automatically.
EBSMCP_DEV_IDENTITY_SUBJECT=dev-user@example.com
EBSMCP_ENTRA_TENANT_ID=
EBSMCP_ENTRA_AUDIENCE=
EBSMCP_ENTRA_SUBJECT_CLAIM=preferred_username
EBSMCP_RESOURCE_SERVER_URL=

# --- DNS-rebinding protection (streamable-http) ---------------------------
# Default [] REJECTS EVERY request with 421. Set to the host(s) the MCP server
# is reached at — the BARE hostname behind a proxy/tunnel (no port), or
# host:port when hit directly. JSON arrays.
#   EBSMCP_ALLOWED_HOSTS=["mcp.corp.com"]
#   EBSMCP_ALLOWED_ORIGINS=["https://mcp.corp.com"]
EBSMCP_ALLOWED_HOSTS=[]
EBSMCP_ALLOWED_ORIGINS=[]

# --- Host ports (optional) ------------------------------------------------
# Change only if these clash with something else on the host.
POSTGRES_HOST_PORT=5433
MANAGEMENT_API_HOST_PORT=8010
ADMIN_GUI_HOST_PORT=5174
MCP_SERVER_HOST_PORT=8080
