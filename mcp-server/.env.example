# Which deployment environment this instance serves — keeps dev/test/uat/prod
# credentials, connectors, and audit trails fully separate (see architecture
# doc, "Multi-environment approach").
EBSMCP_ENVIRONMENT=dev

# Transport for the MCP endpoint. "stdio" is for local development against a
# single client (e.g. Claude Desktop, the MCP inspector); "streamable-http" is
# the enterprise-hosted mode described in the architecture doc, sitting behind
# the cloud edge / OAuth validation.
EBSMCP_TRANSPORT=stdio
EBSMCP_HTTP_HOST=0.0.0.0
EBSMCP_HTTP_PORT=8080

# streamable-http only: DNS-rebinding protection. Both default to an empty
# list, which REJECTS every request (fail closed) until the real hostname(s)
# this server is reachable at are named here — e.g. behind a reverse proxy
# terminating TLS for Copilot at https://mcp.client.com. JSON arrays:
# EBSMCP_ALLOWED_HOSTS=["mcp.client.com"]
# EBSMCP_ALLOWED_ORIGINS=["https://mcp.client.com"]
EBSMCP_ALLOWED_HOSTS=
EBSMCP_ALLOWED_ORIGINS=

# EBS read-only DB connector — single-instance form. Leave EBS_DB_DSN unset
# to run against the in-memory mock connector instead of a real Oracle
# database — useful for exercising the MCP wiring before any real EBS
# credentials exist. Superseded by EBSMCP_EBS_INSTANCES below when that's
# set; otherwise synthesized into one instance named for EBSMCP_ENVIRONMENT.
EBS_DB_DSN=
EBS_DB_USER=
EBS_DB_PASSWORD=

# Multi-instance form: reach several EBS databases (PROD, UAT, QA, or
# whatever names the client uses) from this one deployment, routed per call
# by the instance parameter every DBA tool takes (auto-selected when only
# one instance is configured, or when the caller is only entitled to one —
# see tools/registry.py's _resolve_instance). The read-only DB user/synonym
# setup is the same in every instance; only dsn/password typically differ.
# Example:
# EBSMCP_EBS_INSTANCES={"PROD":{"dsn":"prod-host:1521/EBSPROD","user":"ebsmcp_ro","password":"..."},"UAT":{"dsn":"uat-host:1521/EBSUAT","user":"ebsmcp_ro","password":"..."}}
EBSMCP_EBS_INSTANCES=

# Identity resolution is stubbed in-process for this first core slice (see
# src/ebsmcp/identity/resolver.py) — a real implementation backed by the
# Postgres/Oracle identity-mapping store comes later. This lets local runs
# pretend to be a specific mapped user without a real Entra/EBS setup.
#
# Note: this value drives BOTH "who the caller claims to be" AND the one
# fixed mapping the stub resolver knows about, so a local run this way can
# only ever exercise the "known, mapped caller" path — it will never show
# you the no_identity_mapping / entitlement_denied paths. Those are covered
# instead by tests/test_example_health_tool.py, which builds a ToolContext
# directly so the two can differ.
EBSMCP_DEV_IDENTITY_SUBJECT=dev-user@example.com

# Real identity resolution: point this at the identity-service database
# (same schema, same env var convention as identity-service/management-api's
# IDENTITY_DB_URL) once one exists. Leave unset to keep using the single
# fixed stub mapping above.
IDENTITY_DB_URL=

# Entra ID — leave all three unset until a real app registration exists.
# Once EBSMCP_ENTRA_TENANT_ID, EBSMCP_ENTRA_AUDIENCE, and
# EBSMCP_RESOURCE_SERVER_URL are all set AND EBSMCP_TRANSPORT=streamable-http,
# the server switches from EBSMCP_DEV_IDENTITY_SUBJECT to verifying real
# bearer tokens automatically — see config.Settings.has_real_entra_config
# and server.py. Auth only applies to streamable-http; stdio has no bearer
# token to verify.
EBSMCP_ENTRA_TENANT_ID=
# The API app registration's client ID — tokens must carry this as `aud`.
EBSMCP_ENTRA_AUDIENCE=
# Which validated claim becomes the subject passed to the identity
# resolver. preferred_username (UPN/email) matches the entra_subject
# examples used throughout this project; oid (the immutable object ID) is
# worth switching to for a real deployment, since a UPN can be reassigned
# on a rename in ways an oid cannot.
EBSMCP_ENTRA_SUBJECT_CLAIM=preferred_username
# Where this MCP server itself is reachable — becomes the OAuth resource
# identifier tokens must be scoped to.
EBSMCP_RESOURCE_SERVER_URL=
