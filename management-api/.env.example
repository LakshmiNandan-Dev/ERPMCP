# Identity-mapping database — same database identity-service owns and
# migrates (see identity-service/migrations). management-api connects with
# a least-privilege role that can read/write identity_mappings and
# identity_mapping_org_scope but not, e.g., drop tables — see
# identity-service's role-provisioning notes.
IDENTITY_DB_URL=postgresql+psycopg://mgmt_identity_writer:CHANGEME@localhost:5433/ebsmcp_identity

# Audit database — read-only role. A bug in this API's audit-log endpoint
# cannot write to the audit trail no matter what the code does, because
# the database itself rejects it.
AUDIT_DB_URL=postgresql+psycopg://mgmt_audit_reader:CHANGEME@localhost:5433/ebsmcp_audit

# Real EBS connection for onboarding lookups only (GET /ebs-lookup/...):
# resolving which responsibilities an FND_USER has, and which Org IDs each
# one grants. This is a separate, read-only concern from mcp-server's own
# EBS_DB_DSN/EBS_DB_USER/EBS_DB_PASSWORD — same variable names, but this
# process and mcp-server are typically different deployments and may point
# at different EBS instances (e.g. this admin tooling against prod EBS,
# mcp-server against whichever environment it's serving).
#
# Leave all three unset to keep using MockEBSLookupConnector's canned
# Vision demo data (JDOE) instead of a real Oracle connection — see
# app/ebs/factory.py.
EBS_DB_DSN=
EBS_DB_USER=
EBS_DB_PASSWORD=

# Real admin authentication for THIS API — who's allowed to onboard/close
# identity mappings and edit Entra config, as opposed to entra_registrations
# (a separate concern: the tenant config mcp-server's own OAuth resource
# server validates M365 Copilot bearer tokens against).
#
# Deliberately local accounts (admin_accounts table), not Entra/SSO: admin
# access to this tool stays independent of whichever customer Entra tenant
# a deployment happens to serve — see app.config.Settings's
# admin_session_secret comment.
#
# Leave unset to keep accepting the X-Admin-Subject header stub instead of
# real session tokens — same fallback pattern used everywhere else in this
# project. Setting it switches every admin-gui-facing endpoint (reads
# included) to real username/password sign-in + session-token
# verification automatically — see app.config.Settings.has_local_admin_auth.
# Generate a real value with e.g. `openssl rand -hex 32`; rotating it
# invalidates every outstanding session token, forcing re-login everywhere.
ADMIN_SESSION_SECRET=

# Create the first account with:
#   python scripts/create_admin.py --username admin@corp.com
