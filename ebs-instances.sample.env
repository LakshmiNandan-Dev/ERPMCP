# Sample EBSMCP_EBS_INSTANCES value — one entry per EBS database this MCP
# deployment can reach. Copy the line below into the root .env file (next
# to docker-compose.yml; not committed, see .gitignore) and fill in real
# values, or trim it down to only the instances you actually have.
#
# Shape per instance: {"dsn": "host:port/service_name", "user": "...", "password": "..."}
# - dsn: python-oracledb connect-string format, host:port/service_name —
#   the same DSN you'd hand to sqlplus as user/password@dsn.
# - user: the read-only DB account (see mcp-server's DB-prep docs) —
#   typically the SAME username in every instance (e.g. ebsmcp_ro), since
#   it's created the same way in each database; only the DSN and password
#   normally differ per instance.
# - password: that account's password IN THIS INSTANCE. Different
#   instances are different databases with independently set passwords,
#   even when the username matches.
#
# Instance names (PROD/UAT/QA/DEV below) are arbitrary — use whatever your
# client calls their environments. They're matched case-insensitively
# against the instance parameter every DBA tool takes; when only one is
# configured (or a caller is only entitled to one) it's auto-selected and
# no caller ever needs to pass instance explicitly.
#
# This must be valid JSON on a single line — no trailing commas, no
# comments inside it. Pretty-printed here only for readability:
#
# {
#   "PROD": {"dsn": "ebsprod-db.client.internal:1521/EBSPROD", "user": "ebsmcp_ro", "password": "REPLACE_ME"},
#   "UAT":  {"dsn": "ebsuat-db.client.internal:1521/EBSUAT",   "user": "ebsmcp_ro", "password": "REPLACE_ME"},
#   "QA":   {"dsn": "ebsqa-db.client.internal:1521/EBSQA",     "user": "ebsmcp_ro", "password": "REPLACE_ME"},
#   "DEV":  {"dsn": "ebsdev-db.client.internal:1521/EBSDEV",   "user": "ebsmcp_ro", "password": "REPLACE_ME"}
# }

EBSMCP_EBS_INSTANCES={"PROD":{"dsn":"ebsprod-db.client.internal:1521/EBSPROD","user":"ebsmcp_ro","password":"REPLACE_ME"},"UAT":{"dsn":"ebsuat-db.client.internal:1521/EBSUAT","user":"ebsmcp_ro","password":"REPLACE_ME"},"QA":{"dsn":"ebsqa-db.client.internal:1521/EBSQA","user":"ebsmcp_ro","password":"REPLACE_ME"},"DEV":{"dsn":"ebsdev-db.client.internal:1521/EBSDEV","user":"ebsmcp_ro","password":"REPLACE_ME"}}
