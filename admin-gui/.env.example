VITE_API_BASE_URL=http://localhost:8010

# Real local admin sign-in for admin-gui itself (see src/auth/config.ts)
# — deliberately username/password against management-api's own
# admin_accounts table, not Entra/SSO. A different concern entirely from
# entra_registrations (edited on the Settings tab), which is the tenant
# mcp-server trusts for *end users*, not who can administer this tool.
#
# Leave unset (or "false") to keep using the free-text "Acting as" stub;
# set to "true" to show a real username/password login form instead.
# Only meaningful once management-api's own ADMIN_SESSION_SECRET is set
# and at least one admin_accounts row exists (see
# management-api/scripts/create_admin.py) — until then POST /auth/login
# always 503s, so leave this false until that's done.
VITE_LOCAL_ADMIN_AUTH_ENABLED=false
